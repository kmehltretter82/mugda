cabal-version:      2.4
name:               mugda
version:            1.0.1
synopsis:           Mugda: Termination Checking for a Dependently Typed Language with Sized Types
description:
  Mugda is a prototype dependently typed functional programming language and
  proof assistant featuring dependent pattern matching, inductive and
  coinductive data types, sized types, and size-change termination checking.
  Originally developed by Karl Mehltretter in his 2007 Diploma thesis at LMU
  Munich under the supervision of Andreas Abel.
homepage:           https://github.com/kmehltretter82/mugda
bug-reports:        https://github.com/kmehltretter82/mugda/issues
license:            BSD-3-Clause
author:             Karl Mehltretter
maintainer:         Karl Mehltretter
category:           Language, Dependent Types, Theorem Provers
build-type:         Simple
extra-source-files:
  README.md
  BUG_REVIEW.md
  Lexer.x
  Parser.y

executable mugda
  main-is:          Main.hs
  other-modules:
    Abstract
    Completness
    Concrete
    Control.Monad.Error
    Lexer
    Parser
    SPos
    ScopeChecker
    TermCheck1
    TermCheck2
    Termination
    Tokens
    TraceError
    TypeChecker
    Value
  build-depends:
    base >= 4.9 && < 5,
    containers,
    mtl
  default-language: Haskell98
  ghc-options:      -fwarn-incomplete-patterns
